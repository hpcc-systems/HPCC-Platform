#!/bin/bash

want_list=$(@ADMIN_PATH@/configgen -env @CONFIG_DIR@/@ENV_XML_FILE@ -list) || {
    echo "configgen failed listing components; leaving existing hpccsystems-platform.target unchanged" >&2
    exit 1
}
require_list=$(@ADMIN_PATH@/configgen -env @CONFIG_DIR@/@ENV_XML_FILE@ -t dafilesrv -list) || {
    echo "configgen failed listing dafilesrv; leaving existing hpccsystems-platform.target unchanged" >&2
    exit 1
}
want=($(printf '%s\n' "${want_list}" | awk 'BEGIN {FS="=|;";} NF > 1 && !/dafilesrv/ && !/ftslave/ {printf "%s@%s.service ", $2, $1;}'))
require=($(printf '%s\n' "${require_list}" | awk 'BEGIN {FS="=|;";} NF > 1 && /dafilesrv/ {printf "%s@%s.service ", $2, $1;}'))
all=(${want[@]} ${require[@]})
want_string="${want[@]}"
require_string="${require[@]}"

if [[ -e /etc/systemd/system/hpccsystems-platform.target ]]; then
    rm -f /etc/systemd/system/hpccsystems-platform.target
fi

rm -f /etc/systemd/system/hpccsystems-platform.target
for instance in "${all[@]}"; do
	echo "removing /etc/systemd/system/${instance}"
	rm -f /etc/systemd/system/${instance}
done

mkdir -p @INSTALL_DIR@/etc/systemd/system/gen
# Remove generated instance units (and their enablement links) for components that are
# no longer declared in environment.xml, so systemd does not keep starting them.
for generated in @INSTALL_DIR@/etc/systemd/system/gen/*@*.service; do
    [[ -e "${generated}" || -L "${generated}" ]] || continue
    name="$(basename "${generated}")"
    keep=0
    for instance in "${all[@]}"; do
        if [[ "${instance}" == "${name}" ]]; then
            keep=1
            break
        fi
    done
    if [[ ${keep} -eq 0 ]]; then
        echo "removing obsolete ${name}"
        rm -f "/etc/systemd/system/${name}" "/etc/systemd/system/hpccsystems-platform.target.wants/${name}" "${generated}"
    fi
done

echo "generating hpccsystems platform target from environment.xml"
cd /etc/systemd/system
cat << EOT > @INSTALL_DIR@/etc/systemd/system/gen/hpccsystems-platform.target
[Unit]
Description=hpccsystems-platform components
Requires=${require_string}
Wants=${want_string}

[Install]
WantedBy=multi-user.target
EOT
ln -sf @INSTALL_DIR@/etc/systemd/system/gen/hpccsystems-platform.target hpccsystems-platform.target
for ((i=0; i<${#all[@]}; i++)); do
	component="$(echo "${all[$i]}" | awk 'BEGIN {FS="[.@]";} {print $1;}')"
	instance="$(echo "${all[$i]}" | awk 'BEGIN {FS="[.@]";} {print $2;}')"
	sedcmd="sed 's/\[Unit\]/\[Unit\]\nPartOf=hpccsystems-platform.target/g; s/dafilesrv\.service/${require_string}/g; s/%i/${instance}/g' @INSTALL_DIR@/etc/systemd/system/${component}@.service > @INSTALL_DIR@/etc/systemd/system/gen/${all[$i]}"
    eval "$sedcmd"
	ln -sf @INSTALL_DIR@/etc/systemd/system/gen/${all[$i]} ${all[$i]}
done
systemctl daemon-reload
