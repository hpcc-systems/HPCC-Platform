{
	"folders": [
		{
			"name": "HPCC-Platform",
			"path": "."
		}
	],
	"settings": {
		"cmake.generator": "Ninja",
		"cmake.configureSettings": {
			"CMAKE_BUILD_TYPE": "${buildType}"
		},
		"cmake.configureEnvironment": {
			"EMSDK": "${env:HOME}/emsdk"
		},
		"cmake.configureArgs": [
			"-DEMSCRIPTEN=ON",
			"-DCONTAINERIZED=OFF",
			"-DUSE_OPTIONAL=OFF",
			"-DUSE_CPPUNIT=ON",
			"-DINCLUDE_PLUGINS=ON",
			"-DSUPPRESS_V8EMBED=ON",
			"-DSUPPRESS_REMBED=ON",
			"-DVCPKG_AUTO_UPDATE_SUBMODULE=ON"
		],
		"editor.formatOnSave": false
	},
	"extensions": {
		"recommendations": [
			"ms-vscode.cpptools",
			"ms-vscode.cpptools-extension-pack",
			"ms-vscode.cmake-tools"
		]
	}
}