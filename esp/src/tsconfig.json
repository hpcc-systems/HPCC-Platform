{
    "compilerOptions": {
        "outDir": "./lib",
        "declarationDir": "./types",
        "target": "es2022",
        "noEmit": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "declaration": true,
        "noImplicitAny": false,
        "noImplicitThis": false,
        "noEmitOnError": false,
        "noUnusedLocals": true,
        "noUncheckedSideEffectImports": false,
        "strictBindCallApply": false,
        "strictFunctionTypes": false,
        "strictNullChecks": false,
        "useUnknownInCatchVariables": false,
        "importHelpers": true,
        "allowJs": true,
        "skipLibCheck": true,
        "jsx": "react",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2022"
        ],
        "paths": {
            "hpcc/*": [
                "./src/legacyModules.d.ts"
            ],
            "ganglia/*": [
                "./src/legacyModules.d.ts"
            ],
            "src/*": [
                "./src/*"
            ],
            "src-dojo/*": [
                "./types/src-dojo/*"
            ],
            "src-react/*": [
                "./src-react/*"
            ],
            "src-react-css/*": [
                "./src-react/*"
            ],
            "@hpcc-js/wasm-duckdb": [
                "./node_modules/@hpcc-js/wasm-duckdb",
                "../../../hpcc-js-wasm/packages/duckdb"
            ],
            "@hpcc-js/wasm-graphviz": [
                "./node_modules/@hpcc-js/wasm-graphviz",
                "../../../hpcc-js-wasm/packages/graphviz"
            ],
            "@hpcc-js/*": [
                "./node_modules/@hpcc-js/*",
                "../../../hpcc-js/packages/*",
                "../../../Visualization/packages/*"
            ]
        }
    },
    "include": [
        "src/index.ts",
        "src/legacyModules.d.ts",
        "src-react/index.tsx"
    ],
    "watchOptions": {
        "watchFile": "useFsEvents",
        "watchDirectory": "useFsEvents",
        "excludeDirectories": [
            "**/node_modules"
        ]
    }
}