{
    "name": "eclwatch",
    "version": "1.0.0",
    "description": "'ECL Watch' Web interface for HPCC Platform.",
    "scripts": {
        "install-playwright-deps": "npx playwright install --with-deps",
        "clean": "rimraf ./build ./dist ./lib ./types ./playwright-report ./test-results ./tmp ./src/nlsHPCCType.ts ./node_modules/.vite ./node_modules/.vite-temp ./node_modules/.cache",
        "lint": "eslint ./eclwatch ./src ./src-dojo ./src-react",
        "lint-fix": "eslint --fix eclwatch/**/*.js src/**/*.ts src-react/**/*.ts?",
        "copy-res-eclwatch-img": "copyfiles -u 2 \"./eclwatch/img/**/*.{png,jpg,gif,svg}\" ./build/eclwatch/img/",
        "copy-res-eclwatch-ecl": "copyfiles -u 2 \"./eclwatch/ecl/**/*.*\" ./build/eclwatch/ecl/",
        "copy-res-dojo-img": "copyfiles -u 3 \"./node_modules/dojo/resources/blank.gif\" ./build/eclwatch/img/",
        "copy-res-dojo": "copyfiles -u 3 \"./node_modules/dojo/resources/**/*.{png,jpg,gif}\" ./build/node_modules/dojo/resources/",
        "copy-res-dojox": "copyfiles -u 5 \"./node_modules/dojox/widget/ColorPicker/images/**/*.{png,jpg,gif}\" ./build/eclwatch/img/",
        "copy-res-dgrid-css": "copyfiles -u 2 \"./dgrid/css/**/*\" ./lib/dgrid/css/",
        "copy-res-TopoJSON": "copyfiles -u 4 \"./node_modules/@hpcc-js/map/TopoJSON/**/*\" ./build/dist/TopoJSON/",
        "copy-res-font-awesome": "copyfiles -u 2 \"./node_modules/font-awesome/**/*\" ./build/dist/font-awesome/",
        "copy-res-fluentui-fonts": "copyfiles -f \"./node_modules/@fluentui/font-icons-mdl2/fonts/*\" ./build/dist/fluentui-fonts/",
        "copy-res-html": "copyfiles \"./*.{htm,html}\" ./build/",
        "copy-res-dist-nightly": "copyfiles -u 2 \"./build/dist/**/*\" ./build/dist-nightly/",
        "copy-res": "run-p copy-res-eclwatch-img copy-res-eclwatch-ecl copy-res-dojo-img copy-res-dojo copy-res-dojox copy-res-dgrid-css copy-res-TopoJSON copy-res-font-awesome copy-res-fluentui-fonts copy-res-html",
        "compile": "tsc6 --build tsconfig.dojo.json",
        "compile-watch": "npm run compile -- -w",
        "bundle": "vite build --mode production",
        "bundle-dev": "vite build --mode development",
        "build": "npm-run-all --parallel copy-res compile --serial bundle",
        "build-nightly": "cross-env ECLWATCH_DIST_URL=/esp/files/dist-nightly/ npm-run-all --parallel copy-res compile --serial bundle copy-res-dist-nightly",
        "build-dev": "npm-run-all --parallel copy-res compile --serial bundle-dev",
        "rm-hpcc": "rimraf ./node_modules/@hpcc-js",
        "start": "vite --port 8080",
        "test": "npx playwright test",
        "test-auth": "cross-env AUTH=1 npx playwright test",
        "test-ci": "cross-env CI=1 npx playwright test",
        "test-ci-local": "cross-env CIL=1 npx playwright test",
        "test-full": "cross-env FULL=1 npx playwright test",
        "test-codegen": "npx playwright codegen",
        "test-interactive": "npx playwright test --ui",
        "update": "npx npm-check-updates -u -t minor",
        "update-major": "npx npm-check-updates -u"
    },
    "main": "src/stub.js",
    "dependencies": {
        "@ctrl/tinycolor": "3.6.1",
        "@fluentui-contrib/react-data-grid-react-window": "1.4.2",
        "@fluentui-contrib/react-draggable-dialog": "0.2.5",
        "@fluentui/react-components": "9.74.6",
        "@fluentui/react-datepicker-compat": "0.6.36",
        "@fluentui/react-hooks": "8.10.2",
        "@fluentui/react-nav": "9.4.4",
        "@hpcc-js/chart": "3.8.9",
        "@hpcc-js/codemirror": "3.8.9",
        "@hpcc-js/common": "3.9.4",
        "@hpcc-js/comms": "3.18.0",
        "@hpcc-js/dataflow": "9.7.9",
        "@hpcc-js/dgrid": "3.9.9",
        "@hpcc-js/eclwatch": "3.8.9",
        "@hpcc-js/graph": "3.11.3",
        "@hpcc-js/html": "3.4.9",
        "@hpcc-js/layout": "3.6.9",
        "@hpcc-js/map": "3.7.1",
        "@hpcc-js/other": "3.6.9",
        "@hpcc-js/phosphor": "3.8.7",
        "@hpcc-js/timeline": "3.5.9",
        "@hpcc-js/util": "3.6.9",
        "@hpcc-js/wasm-duckdb": "1.19.0",
        "@hpcc-js/wasm-graphviz": "1.28.0",
        "clipboard": "2.0.11",
        "d3-dsv": "3.0.1",
        "d3-hierarchy": "3.1.2",
        "d3-scale": "4.0.2",
        "dijit": "1.17.3",
        "dijit-themes": "1.17.3",
        "dojo": "1.17.3",
        "dojo-util": "1.17.3",
        "dojox": "1.17.3",
        "font-awesome": "4.7.0",
        "formik": "2.4.9",
        "octokit": "5.0.5",
        "put-selector": "0.3.6",
        "query-string": "9.5.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-hook-form": "7.85.0",
        "react-reflex": "4.2.7",
        "universal-router": "9.2.1",
        "xstyle": "0.3.3"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@hpcc-js/vite-plugins": "1.2.0",
        "@playwright/test": "1.62.1",
        "@simbathesailor/use-what-changed": "2.0.0",
        "@types/dojo": "1.9.49",
        "@types/node": "22.20.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@typescript-eslint/parser": "8.67.0",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitejs/plugin-react": "6.0.5",
        "copyfiles": "2.4.1",
        "cross-env": "10.1.0",
        "eslint": "9.39.5",
        "eslint-plugin-eclwatch": "file:./eslint",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.4",
        "npm-run-all": "4.1.5",
        "rimraf": "6.1.3",
        "tslib": "2.8.1",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "8.67.0",
        "vite": "8.2.1"
    },
    "overrides": {},
    "author": "HPCC Systems",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/hpcc-systems/HPCC-Platform"
    }
}